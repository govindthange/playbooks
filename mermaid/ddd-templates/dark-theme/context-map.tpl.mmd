    contextC1(["<b>Core Subdomain C1</b><br>Context"])

    %% Middle Layer Nodes
    contextS1(["<b>Supporting Subdomain S1</b><br>Context"])
    contextS2(["<b>Supporting Subdomain S2</b><br>Flow Context"])
