    contextS4(["<b>Supporting Subdomain S4</b><br>Context"])

    %% Bottom Node
    contextC2(["<b>Core Subdomain C2</b><br>Context"])

    %% Connections from contextC1
    contextC1 --- contextS1
    contextC1 --- contextS2
    contextC1 --- contextS3
    contextC1 --- contextS4

    %% Connections to contextC2
    contextS1 --- contextC2
    contextS2 --- contextC2
    contextS3 --- contextC2
    contextS4 --- contextC2
  end

  %% Dark Theme Domain Styling Classes
  classDef coreDomainContextClass fill:#211F42,stroke:#7C4DFF,stroke-dasharray: 4 4,stroke-width:2px,color:#FFFFFF;
  classDef supportingDomainContextClass fill:#132E27,stroke:#00E676,stroke-dasharray: 4 4,stroke-width:2px,color:#FFFFFF;
  
  class contextC1,contextC2 coreDomainContextClass;
  class contextS1,contextS2,contextS3,contextS4 supportingDomainContextClass;

